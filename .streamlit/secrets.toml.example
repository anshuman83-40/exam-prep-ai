# Paste this into Streamlit Cloud -> your app -> Settings -> Secrets (fill in your values).
# Never commit a real secrets.toml to GitHub.

GEMINI_API_KEY = "your-gemini-key"

# Smaller re-ranker: the free Streamlit Cloud server has limited memory
RERANK_MODEL = "cross-encoder/ms-marco-MiniLM-L-6-v2"

# Optional: keep student profiles in a free Supabase database (otherwise they are lost
# whenever the app restarts). See README -> "Deploy" for the 1-minute table setup.
# SUPABASE_URL = "https://xxxxxxxx.supabase.co"
# SUPABASE_KEY = "your-service-role-key"
